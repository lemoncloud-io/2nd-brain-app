#!/bin/sh
# e2e 용 — 로그인 상태까지 답하는 가짜 CLI(fake-claude/logged-out)를 공식 설치 위치에 놓는다
mkdir -p "$HOME/.local/bin"
# 가짜 CLI 는 옆의 status.json 을 읽어 로그인 상태를 답한다
cp "$(dirname "$0")/../fake-claude/logged-out/claude" "$(dirname "$0")/../fake-claude/logged-out/status.json" "$HOME/.local/bin/"
chmod +x "$HOME/.local/bin/claude"
echo "Installation complete"
