#!/bin/sh
# fake codex (e2e): --version·login status 에 로그인 상태로 답하고, exec 는 녹화본 모양의 JSONL 을 낸다.
# 읽기 전용 exec(채팅 답·위키화 초안)은 프롬프트로 분기한다. 초안은 @@ 블록으로 답하고
# 파일 쓰기는 앱이 코드로 한다 — 예전 app 레인 흉내(작업 브랜치·커밋)는 파이프라인 전환으로 삭제.
set -e
if [ -n "$FAKE_CODEX_ARGS_LOG" ]; then printf '%s\n' "$*" >> "$FAKE_CODEX_ARGS_LOG"; fi
case "$1" in
  --version) echo "codex-cli 0.154.0"; exit 0 ;;
  # 실측: login status 문구는 stderr 로 나온다
  login) echo "Logged in using ChatGPT" >&2; exit 0 ;;
  # 채팅은 켜 둔 app-server 로 돈다 — 세션 가짜에 맡긴다
  app-server) exec "$(dirname "$0")/../session/codex" "$@" ;;
esac

prompt="$(cat)"
echo '{"type":"thread.started","thread_id":"thread-e2e-codex"}'
echo '{"type":"turn.started"}'

case "$prompt" in
  *"Output contract"*)
    printf '%s\n' '{"type":"item.completed","item":{"id":"item_1","type":"agent_message","text":"@@ wiki/codex-page.md\n---\ntype: concept\ntopics: []\nstatus: draft\n---\n# Codex Page\n\n## Summary\n\ncodex\n"}}'
    echo '{"type":"item.completed","item":{"id":"item_2","type":"agent_message","text":"codex ingest done"}}'
    echo '{"type":"turn.completed","usage":{"input_tokens":1,"output_tokens":1}}'
    exit 0
    ;;
esac

echo '{"type":"item.started","item":{"id":"item_0","type":"command_execution","command":"cat wiki/INDEX.md","aggregated_output":"","exit_code":null,"status":"in_progress"}}'
echo '{"type":"item.completed","item":{"id":"item_1","type":"agent_message","text":"코덱스가 볼트에서 찾은 답"}}'
echo '{"type":"turn.completed","usage":{"input_tokens":1,"output_tokens":1}}'
