{
  "name": "2nd-brain-app",
  "version": "0.1.0",
  "description": "2nd-brain — 개인 볼트 위키화 앱",
  "main": "./out/main/index.js",
  "author": "lemoncloud-io",
  "homepage": "https://github.com/lemoncloud-io/2nd-brain-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemoncloud-io/2nd-brain-app.git"
  },
  "bugs": {
    "url": "https://github.com/lemoncloud-io/2nd-brain-app/issues"
  },
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache . && node scripts/ui-hangul.mjs src",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "test": "vitest run --project unit && vitest run --project watch",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:stray": "left=$(pgrep -fl out/main/index.js | tee /dev/stderr | wc -l | tr -d ' '); test \"$left\" = 0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mozilla/readability": "^0.6.0",
    "@ssabrojs/hwpxjs": "0.4.0",
    "cross-spawn": "7.0.6",
    "dugite": "3.2.3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "jsdom": "^30.1.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "read-excel-file": "9.3.12",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.1",
    "@types/pako": "2.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "cfb": "1.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror": "^6.0.2",
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "katex": "0.16.47",
    "lucide-react": "1.45.0",
    "mermaid": "12.1.0",
    "pako": "2.1.0",
    "pretendard": "1.3.9",
    "prettier": "^3.7.4",
    "radix-ui": "1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "dugite"
    ]
  }
}
